<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup is false, so Auto Backup to the cloud is already off. This file covers the
  other half: on Android 12+ device-to-device transfer is permitted by default and allowBackup
  does not govern it. Patient records, receipt images and the cached Firebase session all live in
  app storage, so every domain is excluded from both channels.
  https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
