<?xml version="1.0" encoding="utf-8"?>
<!--
  Consulted only below API 31, and only if android:allowBackup is ever turned back on. It stays
  here so that flipping that flag cannot silently start shipping patient data to Google Drive:
  the default with no rules file is "back up everything".
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
